        "id": "b9b0ff1c"
      },
      "outputs": [],
      "source": [
        "# ── Video paths (same as M1) ──\n",
        "CLIPS = [\n",
        "    \"/content/clip1_presenter.mp4\",\n",
        "    \"/content/clip2_presenter.mp4\",\n",
        "    \"/content/clip3_presenter.mp4\",\n",
        "]\n",
        "\n",
        "CLIP_IDX = 0  # Change to 1 or 2 for other clips\n",
        "video_path = CLIPS[CLIP_IDX]\n",
        "clip_name = video_path.split(\"/\")[-1].replace(\".mp4\", \"\")\n",
        "\n",
        "print(f\"Working on: {clip_name}\")\n",
        "print(f\"Path: {video_path}\")\n",
        "\n",
        "# Quick check\n",
        "cap_check = cv2.VideoCapture(video_path)\n",
        "total_frames = int(cap_check.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "fps = cap_check.get(cv2.CAP_PROP_FPS)\n",
        "w = int(cap_check.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "h = int(cap_check.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "cap_check.release()\n",
        "\n",
        "print(f\"Resolution: {w}x{h} | FPS: {fps} | Frames: {total_frames}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "6080b688",
      "metadata": {
        "id": "6080b688"
      },
      "outputs": [],
      "source": [
        "# ── Load M1 keypoints CSV ──\n",
        "keypoints_csv_path = \"outputs/presenter_keypoints.csv\"\n",
        "\n",
        "if os.path.exists(keypoints_csv_path):\n",
        "    m1_keypoints = pd.read_csv(keypoints_csv_path)\n",
        "    clip_kp = m1_keypoints[m1_keypoints[\"clip\"] == clip_name]\n",
        "    print(f\"M1 keypoints loaded: {len(m1_keypoints)} total rows\")\n",
        "    print(f\"Rows for {clip_name}: {len(clip_kp)} ({clip_kp['frame'].nunique()} frames)\")\n",
        "    print(clip_kp.head(10))\n",
        "else:\n",
        "    print(\"⚠️ M1 keypoints CSV not found. Run M1 notebook first.\")\n",
        "    print(\"   Tracking will still work — we just can't cross-reference.\")"
      ]
    },
    {
