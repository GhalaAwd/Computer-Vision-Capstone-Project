    {
      "cell_type": "code",
      "execution_count": null,
      "id": "9dc17513",
      "metadata": {
        "id": "9dc17513"
      },
      "outputs": [],
      "source": [
        "model = YOLO(\"yolo11m-pose.pt\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "e6ef492c",
      "metadata": {
        "id": "e6ef492c"
      },
      "outputs": [],
      "source": [
        "# ── cv2.VideoCapture → per-frame process → cv2.VideoWriter ──\n",
        "\n",
        "cap = cv2.VideoCapture(video_path)\n",
        "w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "original_fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "\n",
        "# Sampling: process at ~5 FPS to keep output small\n",
        "TARGET_FPS = 5\n",
        "skip_rate = max(1, int(original_fps / TARGET_FPS))\n",
        "print(f\"Original FPS: {original_fps:.1f} | Sampling every {skip_rate} frames → ~{TARGET_FPS} FPS\")\n",
        "\n",
        "temp_tracked = f\"/content/{clip_name}_tracked_raw.mp4\"\n",
        "final_tracked = f\"/content/{clip_name}_tracked.mp4\"\n",
        "\n",
        "writer = cv2.VideoWriter(temp_tracked, cv2.VideoWriter_fourcc(*'mp4v'), TARGET_FPS, (w, h))\n",
        "\n",
        "# Storage for spatial-coverage analysis (Section 5)\n",
        "presenter_centroids = []  # list of (frame_idx, cx, cy)\n",
        "\n",
        "# COCO-17 skeleton connections for drawing\n",
        "SKELETON = [\n",
        "    (0, 1), (0, 2), (1, 3), (2, 4),              # head\n",
        "    (5, 6), (5, 7), (7, 9), (6, 8), (8, 10),     # arms\n",
        "    (5, 11), (6, 12), (11, 12),                   # torso\n",
        "    (11, 13), (13, 15), (12, 14), (14, 16)        # legs\n",
        "]\n",
        "\n",
        "frame_idx = 0\n",
        "sampled = 0\n",
        "\n",
        "while cap.isOpened():\n",
        "    success, im0 = cap.read()\n",
        "    if not success:\n",
        "        break\n",
        "\n",
        "    if frame_idx % skip_rate == 0:\n",
        "        # ── Track with ByteTrack for stable IDs ──\n",
        "        results = model.track(\n",
        "            source=im0,\n",
        "            persist=True,\n",
        "            tracker=\"bytetrack.yaml\",\n",
        "            conf=0.3,\n",
        "            verbose=False\n",
        "        )\n",
        "        result = results[0]\n",
        "\n",
        "        annotated = im0.copy()\n",
        "\n",
        "        if result.boxes is not None and result.boxes.id is not None:\n",
        "            boxes = result.boxes.xyxy.cpu().numpy()        # (N, 4)\n",
        "            track_ids = result.boxes.id.cpu().numpy()       # (N,)\n",
        "            keypoints = result.keypoints                     # Keypoints object\n",
        "\n",
        "            # ── Presenter rule (same as M1): largest bbox area ──\n",
        "            areas = (boxes[:, 2] - boxes[:, 0]) * (boxes[:, 3] - boxes[:, 1])\n",
        "            best_idx = int(np.argmax(areas))\n",
        "            best_id = int(track_ids[best_idx])\n",
        "            x1, y1, x2, y2 = boxes[best_idx].astype(int)\n",
        "\n",
        "            # Record centroid for spatial coverage\n",
        "            cx, cy = (x1 + x2) // 2, (y1 + y2) // 2\n",
        "            presenter_centroids.append((frame_idx, cx, cy))\n",
        "\n",
        "            # Draw presenter bounding box + track ID\n",
        "            cv2.rectangle(annotated, (x1, y1), (x2, y2), (0, 255, 0), 2)\n",
        "            cv2.putText(annotated, f\"Presenter ID:{best_id}\",\n",
        "                        (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                        0.7, (0, 255, 0), 2)\n",
        "\n",
        "            # Draw pose keypoints for presenter only\n",
        "            if keypoints is not None and keypoints.data.shape[0] > 0:\n",
        "                kpts = keypoints.data[best_idx].cpu().numpy()  # (17, 3)\n",
        "                for kp in kpts:\n",
        "                    kx, ky, kconf = int(kp[0]), int(kp[1]), kp[2]\n",
        "                    if kconf > 0.3:\n",
        "                        cv2.circle(annotated, (kx, ky), 4, (0, 0, 255), -1)\n",
        "                for s, e in SKELETON:\n",
        "                    if kpts[s][2] > 0.3 and kpts[e][2] > 0.3:\n",
        "                        pt1 = (int(kpts[s][0]), int(kpts[s][1]))\n",
        "                        pt2 = (int(kpts[e][0]), int(kpts[e][1]))\n",
        "                        cv2.line(annotated, pt1, pt2, (255, 255, 0), 2)\n",
        "\n",
        "            # Draw centroid trail (last 30 points)\n",
        "            recent = presenter_centroids[-30:]\n",
        "            for i in range(1, len(recent)):\n",
        "                pt1 = (recent[i - 1][1], recent[i - 1][2])\n",
        "                pt2 = (recent[i][1], recent[i][2])\n",
        "                cv2.line(annotated, pt1, pt2, (255, 0, 255), 2)\n",
        "\n",
        "        writer.write(annotated)\n",
        "        sampled += 1\n",
        "\n",
        "    frame_idx += 1\n",
        "\n",
        "cap.release()\n",
        "writer.release()\n",
        "\n",
        "# Re-encode for Colab playback\n",
        "os.system(f\"ffmpeg -i {temp_tracked} -vcodec libx264 -f mp4 {final_tracked} -y -loglevel quiet\")\n",
        "\n",
        "print(f\"✅ Processed {frame_idx} source frames ({sampled} sampled)\")\n",
        "print(f\"📍 Centroids recorded: {len(presenter_centroids)}\")"
      ]
    },
