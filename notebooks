        "id": "3577880c"
      },
      "outputs": [],
      "source": [
        "os.makedirs(\"outputs\", exist_ok=True)\n",
        "\n",
        "if len(presenter_centroids) < 2:\n",
        "    print(\"⚠️ Not enough centroid data. Check that tracking detected a presenter.\")\n",
        "else:\n",
        "    centroids_arr = np.array(presenter_centroids)  # (N, 3): frame, cx, cy\n",
        "    cx_arr = centroids_arr[:, 1].astype(float)\n",
        "    cy_arr = centroids_arr[:, 2].astype(float)\n",
        "\n",
        "    # ── 5.1 Grid Occupancy ──\n",
        "    GRID_SIZE = 10  # 10x10 grid\n",
        "    cell_w, cell_h = w / GRID_SIZE, h / GRID_SIZE\n",
        "\n",
        "    visited_cells = set()\n",
        "    for cx, cy in zip(cx_arr, cy_arr):\n",
        "        gx = min(int(cx // cell_w), GRID_SIZE - 1)\n",
        "        gy = min(int(cy // cell_h), GRID_SIZE - 1)\n",
        "        visited_cells.add((gx, gy))\n",
        "\n",
        "    total_cells = GRID_SIZE * GRID_SIZE\n",
        "    occupancy_pct = (len(visited_cells) / total_cells) * 100\n",
        "\n",
        "    # ── 5.2 Total Distance ──\n",
        "    diffs = np.diff(centroids_arr[:, 1:3].astype(float), axis=0)\n",
        "    distances = np.sqrt((diffs ** 2).sum(axis=1))\n",
        "    total_distance_px = float(distances.sum())\n",
        "    avg_speed = float(distances.mean()) if len(distances) > 0 else 0.0\n",
        "\n",
        "    # ── 5.3 Summary ──\n",
        "    print(\"=\" * 50)\n",
        "    print(f\"📊 Spatial Coverage — {clip_name}\")\n",
        "    print(\"=\" * 50)\n",
        "    print(f\"  Grid size:         {GRID_SIZE}x{GRID_SIZE}\")\n",
        "    print(f\"  Cells visited:     {len(visited_cells)} / {total_cells}\")\n",
        "    print(f\"  Grid occupancy:    {occupancy_pct:.1f}%\")\n",
        "    print(f\"  Total distance:    {total_distance_px:.1f} px\")\n",
        "    print(f\"  Avg speed:         {avg_speed:.1f} px/frame\")\n",
        "    print(f\"  Centroid samples:  {len(presenter_centroids)}\")\n",
        "    print(\"=\" * 50)\n",
        "\n",
        "    # ── 5.4 Export JSON → M5 ──\n",
        "    coverage_stats = {\n",
        "        \"clip\": clip_name,\n",
        "        \"grid_size\": GRID_SIZE,\n",
        "        \"cells_visited\": len(visited_cells),\n",
        "        \"total_cells\": total_cells,\n",
        "        \"grid_occupancy_pct\": round(occupancy_pct, 2),\n",
        "        \"total_distance_px\": round(total_distance_px, 2),\n",
        "        \"avg_speed_px_per_frame\": round(avg_speed, 2),\n",
        "        \"num_centroid_samples\": len(presenter_centroids),\n",
        "        \"frame_width\": w,\n",
        "        \"frame_height\": h,\n",
        "    }\n",
        "\n",
        "    json_path = f\"outputs/{clip_name}_coverage_stats.json\"\n",
        "    with open(json_path, \"w\") as f:\n",
        "        json.dump(coverage_stats, f, indent=2)\n",
        "    print(f\"\\n✅ Coverage stats saved: {json_path}\")"
      ]
    },
