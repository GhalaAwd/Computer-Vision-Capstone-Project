      "source": [
        "cap = cv2.VideoCapture(video_path)\n",
        "w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "original_fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "skip_rate = max(1, int(original_fps / TARGET_FPS))\n",
        "\n",
        "temp_heatmap = f\"/content/{clip_name}_heatmap_raw.mp4\"\n",
        "final_heatmap = f\"/content/{clip_name}_heatmap.mp4\"\n",
        "\n",
        "# Initialize heatmap solution — person class only (class 0)\n",
        "heatmap = solutions.Heatmap(\n",
        "    model=\"yolo11m-pose.pt\",\n",
        "    colormap=cv2.COLORMAP_JET,\n",
        "    show=False,\n",
        "    classes=[0],\n",
        ")\n",
        "\n",
        "writer = cv2.VideoWriter(temp_heatmap, cv2.VideoWriter_fourcc(*'mp4v'), TARGET_FPS, (w, h))\n",
        "\n",
        "frame_idx = 0\n",
        "last_heatmap_frame = None\n",
        "\n",
        "while cap.isOpened():\n",
        "    success, im0 = cap.read()\n",
        "    if not success:\n",
        "        break\n",
        "\n",
        "    if frame_idx % skip_rate == 0:\n",
        "        out = heatmap(im0)\n",
        "        annotated_hm = out.plot_im\n",
        "        writer.write(annotated_hm)\n",
        "        last_heatmap_frame = annotated_hm.copy()\n",
        "\n",
        "    frame_idx += 1\n",
        "\n",
        "cap.release()\n",
        "writer.release()\n",
        "\n",
        "# Re-encode for Colab playback\n",
        "os.system(f\"ffmpeg -i {temp_heatmap} -vcodec libx264 -f mp4 {final_heatmap} -y -loglevel quiet\")\n",
        "\n",
        "# Save aggregate heatmap PNG\n",
        "os.makedirs(\"outputs\", exist_ok=True)\n",
        "aggregate_path = f\"outputs/{clip_name}_aggregate_heatmap.png\"\n",
        "if last_heatmap_frame is not None:\n",
        "    cv2.imwrite(aggregate_path, last_heatmap_frame)\n",
        "    print(f\"✅ Aggregate heatmap saved: {aggregate_path}\")\n",
        "\n",
        "print(f\"📊 Processed {frame_idx // skip_rate} sampled frames for heatmap\")"
      ]
    },
